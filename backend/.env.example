# Server Configuration
HOST=0.0.0.0
PORT=8000
SAVED_REPORTS_DIR=saved_reports
CORS_ORIGINS=*
APP_NAME=HZF & BIN Inspector Studio API
APP_VERSION=2.3.0
APP_ENV=production
DEBUG=False

# Neon PostgreSQL Database Connection
# Replace with your Neon connection string from Neon Console
DATABASE_URL=postgresql://username:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini AI Configuration
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-flash-lite-latest,gemini-3-flash-preview
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30.0

